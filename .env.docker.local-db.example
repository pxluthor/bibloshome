# Banco MySQL local (host da máquina)
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=root123
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=biblioteca

# Chave secreta JWT — trocar em produção
SECRET_KEY=troque-esta-chave-em-producao

# Pastas da biblioteca no host
BIBLIOTECA_HOST_DIR=E:\BIBLIOTECA
FOR_INSERT_HOST_DIR=E:\for_insert

# URL pública da API (usada no build do frontend)
VITE_API_URL=https://api-library.pxluthor.com.br

# Pasta onde o ChromaDB persiste os embeddings (IA / RAG)
CHROMA_HOST_DIR=E:\bibloshome_chromadb

# IA — modelos padrão (Ollama local via host.docker.internal)
OLLAMA_DEFAULT_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI — opcional; deixar vazio para usar só Ollama
OPENAI_API_KEY=
